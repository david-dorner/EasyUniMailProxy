# EasyUniMailProxy configuration - University of Graz.
# Copy to .env and fill in the carrier VPN account.
#   cp .env.example .env
# .env is gitignored - it holds the carrier VPN account secret.

# ── Carrier VPN account ──────────────────────────────────────────────────────
# ONE uni account keeps the tunnel up; every mail user then logs into their OWN
# mailbox through it (they do NOT need to be this account). VPN username is the
# plain email (not the bzedvz form used in mail clients).
VPN_USERNAME=your.name@edu.uni-graz.at
VPN_PASSWORD=your-unilogin-password

# TOTP secret (base32) - the seed behind your authenticator's 6-digit codes.
# (University of Graz = SHA-1 / 30s / 6 digits.) Paste the bare secret, e.g. the
# `secret=` value from your otpauth:// QR text.
VPN_TOTP_SECRET=XXXXXXXXXXXXXXXX

# ── Watchdog alerts (ntfy) ───────────────────────────────────────────────────
# Pick a long, hard-to-guess topic and subscribe to it in the ntfy app or at
# https://ntfy.sh . Alerts go over the normal internet, so they still arrive
# when the uni VPN itself is down.
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-secret-topic
# Optional bearer token for reserved / self-hosted topics (blank for public ntfy.sh).
NTFY_TOKEN=

# ── Host binding ─────────────────────────────────────────────────────────────
# Interface the mail ports (993/587) bind to on the host. Keep this box behind a
# firewall that only lets trusted clients reach 993/587 (see README -> Security).
BIND_ADDR=0.0.0.0

# ── Mail server certificate ──────────────────────────────────────────────────
# The box terminates the client's TLS with its OWN certificate, so there is no
# certificate warning on any device. MAIL_HOSTNAME is the name your clients
# connect to and the name on the certificate; point it at this server in DNS.
MAIL_HOSTNAME=mail.server.dorner-steindl.com

# How to obtain that certificate:
#   cloudflare-dns  Let's Encrypt via Cloudflare DNS-01: free, auto-renewing,
#                   trusted everywhere, works behind NAT. Needs the two lines
#                   below. Recommended.
#   http-01         Let's Encrypt via HTTP-01: free, but needs inbound port 80.
#                   Needs ACME_EMAIL.
#   manual          Bring your own certificate: set CERT_FILE and CERT_KEY.
#   selfsigned      Self-signed, LAN/testing only (clients will warn).
CERT_MODE=selfsigned
# For cloudflare-dns / http-01: the Let's Encrypt account email (renewal notices).
#ACME_EMAIL=you@example.com
# For cloudflare-dns: a scoped Cloudflare API token with Zone:DNS:Edit on your
# domain (Cloudflare -> My Profile -> API Tokens). Keep it secret; .env only.
#CF_DNS_API_TOKEN=
# For manual: paths (inside the container) to your certificate and key.
#CERT_FILE=/certs/your-cert.pem
#CERT_KEY=/certs/your-key.pem

# ── At-rest encryption key handling ──────────────────────────────────────────
# The master key protects stored credentials and cached mail on disk.
#   auto       use the TPM if this machine has one, else autostart. Default.
#   tpm        seal/unseal the key to the TPM (hands-off, key never stored on disk).
#   autostart  keep MASTER_KEY (below) on the box; unattended, weaker at rest.
#   passphrase enter it when the stack starts; strongest, but manual after a reboot.
KEY_MODE=auto
# For autostart mode only: a long random secret, e.g. `openssl rand -base64 48`.
#MASTER_KEY=

# ── Optional tuning ──────────────────────────────────────────────────────────
# The university expires the VPN session about every 24 hours. Instead of waiting
# for that hard expiry, the box re-authenticates itself at these fixed local
# times, a short (about 4 second) reconnect at quiet hours. Two times a day keep
# the gap under 24h with no drift. Change them if you like:
#VPN_REFRESH_TIMES=03:00,04:00
# Timezone the refresh times (and log timestamps) are interpreted in. Set this to
# your server's timezone.
#TZ=Europe/Berlin

# Further advanced knobs exist with safe defaults (VPN reconnect/DPD timing,
# session-token age, watchdog probe intervals and statistics limits). You do not
# need to set any of them; see docs/DEVELOPMENT.md, "Advanced tuning", for the list.
