# EasyUniMailProxy configuration - University of Graz.
# Copy to .env and fill in the carrier VPN account.
#   cp .env.example .env
# .env is gitignored - it holds the carrier VPN account secret.

# ── Carrier VPN account ──────────────────────────────────────────────────────
# ONE uni account keeps the tunnel up; every mail user then logs into their OWN
# mailbox through it (they do NOT need to be this account). VPN username is the
# plain email (not the bzedvz form used in mail clients).
VPN_USERNAME=your.name@edu.uni-graz.at
VPN_PASSWORD=your-unilogin-password

# TOTP secret (base32) - the seed behind your authenticator's 6-digit codes.
# (University of Graz = SHA-1 / 30s / 6 digits.) Paste the bare secret, e.g. the
# `secret=` value from your otpauth:// QR text.
VPN_TOTP_SECRET=XXXXXXXXXXXXXXXX

# ── Watchdog alerts (ntfy) ───────────────────────────────────────────────────
# Pick a long, hard-to-guess topic and subscribe to it in the ntfy app or at
# https://ntfy.sh . Alerts go over the normal internet, so they still arrive
# when the uni VPN itself is down.
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-secret-topic
# Optional bearer token for reserved / self-hosted topics (blank for public ntfy.sh).
NTFY_TOKEN=

# ── Host binding ─────────────────────────────────────────────────────────────
# Interface the mail ports (993/587) bind to on the host. Keep this box behind a
# firewall that only lets trusted clients reach 993/587 (see README -> Security).
BIND_ADDR=0.0.0.0

# ── Optional tuning ──────────────────────────────────────────────────────────
# The university expires the VPN session about every 24 hours. Instead of waiting
# for that hard expiry, the box re-authenticates itself at these fixed local
# times, a short (about 4 second) reconnect at quiet hours. Two times a day keep
# the gap under 24h with no drift. Change them if you like:
#VPN_REFRESH_TIMES=03:00,04:00
# Timezone the refresh times (and log timestamps) are interpreted in. Set this to
# your server's timezone.
#TZ=Europe/Berlin
